{
    // ── Model Context Protocol (MCP) Configuration ───────────────────────────
    "chat.mcp.serverSampling": {
        "daharness/.vscode/mcp.json: framework (daharness)": {
            "allowedModels": [
                "agent-host-copilotcli:ollama-models/gemma4:cloud",
                "agent-host-copilotcli:ollama-models/glm-4.7-flash:latest",
                "agent-host-copilotcli:ollama-models/glm-5.2:cloud",
                "agent-host-copilotcli:ollama-models/glm-5.3-flash:cloud",
                "agent-host-copilotcli:ollama-models/nomic-embed-text:latest",
                "agent-host-copilotcli:ollama-models/ornith-1.5:35b",
                "agent-host-copilotcli:ollama-models/qwen3.6:27b",
                "agent-host-copilotcli:ollama-models/qwen3.8:27b"
            ]
        }
    },

    // ── Unified Python Language Server Settings ──────────────────────────────
    "python.languageServer": "None",

    // ── Custom REPL Stub Hook-In (Pylance/Pyright Engine) ────────────────────
    // Remapped absolute path to your framework-stubs directory
    "python.analysis.stubPath": "/home/kali/.local/share/framework-stubs",
    "python.analysis.extraPaths": [
        "/home/kali/.local/share/framework-stubs",
        "${workspaceFolder}"
    ],
        // ── Complete Lint/Warning Suppression ────────────────────────────────────
    "python.analysis.diagnosticSeverityOverrides": {
        // This is the silver bullet for your script namespace injection:
        "reportUndefinedVariable": "none",
        
        // Keeps things quiet when parsing dynamic modules across your framework
        "reportMissingImports": "none",
        "reportMissingModuleSource": "none"
    }
}


