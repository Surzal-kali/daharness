{
    // ── Existing Chat/MCP Settings ───────────────────────────────────────────
    "chat.mcp.serverSampling": {
        "stuff/.vscode/mcp.json: framework (daharness)": {
            "allowedModels": [
                "agent-host-copilotcli:ollama-models/gemma4:cloud",
                "agent-host-copilotcli:ollama-models/glm-4.7-flash:latest",
                "agent-host-copilotcli:ollama-models/glm-5.2:cloud",
                "agent-host-copilotcli:ollama-models/glm-5.3-flash:cloud",
                "agent-host-copilotcli:ollama-models/nomic-embed-text:latest",
                "agent-host-copilotcli:ollama-models/ornith-1.5:35b",
                "agent-host-copilotcli:ollama-models/qwen3.6:27b",
                "agent-host-copilotcli:ollama-models/qwen3.8:27b"
            ]
        }
    },

    // ── Custom REPL Stub Hook-In (Pylance/Pyright) ───────────────────────────
    
    // Tells Pylance where to find the generated stub (.pyi) signatures
    "python.analysis.stubPath": "/home/YOUR_USERNAME/.local/share/framework-stubs",

    // Tells Pylance to include the directory for runtime resolution fallback
    "python.analysis.extraPaths": [
        "/home/YOUR_USERNAME/.local/share/framework-stubs"
    ],

    // ── Linter Optimization for Security Tool Scripts ─────────────────────────
    "python.analysis.diagnosticSeverityOverrides": {
        // Keeps things quiet if your script imports * from your generated framework
        "reportMissingImports": "none",
        "reportMissingModuleSource": "warning"
    }
}
