{
    // ── Model Context Protocol (MCP) Configuration ───────────────────────────
    "chat.mcp.serverSampling": {
        "daharness/.vscode/mcp.json: framework (daharness)": {
            "allowedModels": [
                "agent-host-copilotcli:ollama-models/gemma4:cloud",
                "agent-host-copilotcli:ollama-models/glm-4.7-flash:latest",
                "agent-host-copilotcli:ollama-models/glm-5.2:cloud",
                "agent-host-copilotcli:ollama-models/glm-5.3-flash:cloud",
                "agent-host-copilotcli:ollama-models/nomic-embed-text:latest",
                "agent-host-copilotcli:ollama-models/ornith-1.5:35b",
                "agent-host-copilotcli:ollama-models/qwen3.6:27b",
                "agent-host-copilotcli:ollama-models/qwen3.8:27b"
            ]
        }
    },

    // ── Unified Python Language Server Settings ──────────────────────────────
    "python.languageServer": "Default",
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",

    // ── Custom REPL Stub Hook-In (Pylance/Pyright Engine) ────────────────────
    // Keep analysis paths resolvable from the code-server container namespace.
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],
        // ── Complete Lint/Warning Suppression ────────────────────────────────────
    "python.analysis.diagnosticSeverityOverrides": {
        // This is the silver bullet for your script namespace injection:
        "reportUndefinedVariable": "none",
        
        // Keeps things quiet when parsing dynamic modules across your framework
        "reportMissingImports": "none",
        "reportMissingModuleSource": "none"
    },
    "github.copilot.chat.copilotDebugCommand.enabled": false,
    "github.copilot.chat.tools.viewImage.enabled": false,
    "github.copilot.chat.exploreAgent.enabled": false,
    "github.copilot.chat.gemini35FlashReducedToolUsePrompt.enabled": false,
    "github.copilot.chat.gpt55GetChangedFilesTool.enabled": false,
    "github.copilot.chat.gpt55ReadFileTool.enabled": false,
    "github.copilot.chat.gpt56Verbosity.enabled": false,
    "github.copilot.chat.languageContext.typescript.enabled": false,
    "github.copilot.chat.newWorkspaceCreation.enabled": false,
    "github.copilot.chat.setupTests.enabled": false,
    "github.copilot.chat.summarizeAgentConversationHistory.enabled": false,
    "github.copilot.chat.updated53CodexPrompt.enabled": false,
    "github.copilot.chat.agent.currentEditorContext.enabled": false,
    "github.copilot.chat.backgroundAgent.enabled": false,
    "github.copilot.chat.cloudAgent.enabled": false,
    "github.copilot.chat.imageUpload.enabled": false,
    "github.copilot.chat.localIndex.enabled": false,
    "github.copilot.chat.organizationCustomAgents.enabled": false,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true
}


